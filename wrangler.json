{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eddy-diniz-nutri",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eddy-diniz-agenda",
      "database_id": "25774413-57e3-403a-8ba2-6bf2f92e90f6"
    }
  ]
}
